# --- process
ROLE=all                     # all | api | bot | indexer | keeper | notifier
PORT=8443                    # Telegram webhooks accept 443, 80, 88, 8443 only (TLS required)
PUBLIC_URL=https://sign.example.com
BOT_MODE=webhook             # webhook (prod) | polling (local dev)

# --- storage
DATABASE_URL=postgres://cofer:cofer@localhost:5432/cofer
REDIS_URL=redis://127.0.0.1:6379

# --- chain (Robinhood Chain mainnet 4663; testnet 46630)
CHAIN_ID=4663
RHC_RPC_URL=https://api-robinhood-mainnet-archive.n.dwellir.com/YOUR_KEY
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
# USDG_ADDRESS=0x...        # optional; defaults to mainnet USDG. On testnet set the mock USDG (must equal factory.usdg())
START_BLOCK=0
CONFIRMATIONS=20
RELAYER_PRIVATE_KEY=0x...   # fresh key, funded with a little ETH for execute() gas; holds no user funds

# --- smart accounts (signer site)
BUNDLER_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT/chain/4663
PAYMASTER_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT/chain/4663
PASSKEY_SERVER_URL=https://passkeys.zerodev.app/api/v3/YOUR_PROJECT

# --- telegram (plain bot: never register a Mini App on this bot)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=CoferBot
TELEGRAM_WEBHOOK_SECRET=change-me-16-plus-chars
LINK_SECRET=change-me-32-plus-random-characters-here

# --- data / cards
STOCK_API_BASE=https://api.robinhood.com/rhj
CARD_ADAPTER=stub            # stub | provider (provider adapter is implemented out of band)
CARD_PROVIDER_URL=
CARD_PROVIDER_KEY=
