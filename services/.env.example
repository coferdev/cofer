# --- process
ROLE=all                     # all | api | bot | indexer | keeper | notifier
PORT=8443                    # Telegram webhooks accept 443, 80, 88, 8443 only (TLS required)
PUBLIC_URL=https://sign.example.com
BOT_MODE=webhook             # webhook (prod) | polling (local dev)

# --- storage
DATABASE_URL=postgres://cofer:cofer@localhost:5432/cofer
REDIS_URL=redis://127.0.0.1:6379

# --- chain (Robinhood Chain mainnet 4663; testnet 46630)
CHAIN_ID=4663
RHC_RPC_URL=https://api-robinhood-mainnet-archive.n.dwellir.com/YOUR_KEY   # server only, never sent to a browser
# SIGNER_RPC_URL=https://rpc.mainnet.chain.robinhood.com  # optional; the signer page's RPC (sent to every browser: never a keyed URL). Defaults to the chain's public RPC
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
# USDG_ADDRESS=0x...        # optional; defaults to mainnet USDG. On testnet set the mock USDG (must equal factory.usdg())
START_BLOCK=0
CONFIRMATIONS=20
RELAYER_PRIVATE_KEY=0x...   # fresh key, funded with a little ETH for execute() gas; holds no user funds
# RELAYER_MIN_ETH=0.005         # optional; alert when the relayer's ETH balance (gas for executing passed votes) is below this
# EXPECTED_OWNER=0x5ACD09eAe4f160e2f2e2356e6eF0496EF6f0f064   # optional; the owner Safe. The keeper alerts if the factory or fee router owner differs
# EXPECTED_GUARDIAN=            # optional; the guardian wallet. The keeper alerts if it differs

# --- smart accounts (signer site)
BUNDLER_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT/chain/4663
PAYMASTER_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT/chain/4663
PASSKEY_SERVER_URL=https://passkeys.zerodev.app/api/v3/YOUR_PROJECT

# --- telegram (plain bot: never register a Mini App on this bot)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=CoferBot
TELEGRAM_WEBHOOK_SECRET=change-me-16-plus-chars
LINK_SECRET=change-me-32-plus-random-characters-here

# --- data / cards
# OPS_CHAT_ID=123456789        # optional; your private chat with the bot, for keeper alerts (send /chatid there to see it). Unset = alerts go to the log only
# ALERT_BOT_TOKEN=             # optional secret; a separate bot (from BotFather) that sends alerts to OPS_CHAT_ID. Press Start in your private chat with it first. Unset = the main bot sends them
# HEALTHCHECK_PING_URL=        # optional, keep private; e.g. a healthchecks.io check (period 5 min, grace 10 min), pinged every 5 min while the backend is healthy
STOCK_API_BASE=https://api.robinhood.com/rhj
CARD_ADAPTER=off             # off | stub (testnet 46630 only, issues no real card) | provider (implemented out of band)
CARD_STUB_FUNDING_ADDRESS=   # stub only: a testnet address you control, where card spends go
CARD_PROVIDER_URL=
CARD_PROVIDER_KEY=
