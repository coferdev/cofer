pragma solidity 0.8.28;

/// @notice Shared types for the Arena contracts (spec §3.2).
library ArenaTypes {
    enum Mode {
        FRIEND,
        FREEROLL
    }

    enum State {
        Open,
        Locked,
        Settling,
        Disputed,
        Settled,
        Refunded
    }

    struct TableParams {
        Mode mode;
        address token; // FRIEND: USDG only. FREEROLL: prize token (USDG or COFR)
        uint96 buyIn; // FRIEND: 1e6..factory.maxBuyIn(). FREEROLL: 0
        uint96 prize; // FREEROLL: pulled from msg.sender at creation. FRIEND: 0
        uint16 minSeats; // >= 2
        uint16 maxSeats; // FRIEND <= 10. FREEROLL <= 4096
        uint64 lockAt; // scheduled start; 0 = sit-and-go (locks when full)
        uint64 openUntil; // sit-and-go: required, now < openUntil <= now + 7d
        uint32 duration; // seconds of play after lock. FRIEND: >= 24h (factory-enforced)
        uint32 disputeWindow; // factory-fixed per mode: FRIEND 2h, FREEROLL 24h
        uint32 settleGrace; // hardDeadline = endAt + settleGrace; FRIEND 24h, FREEROLL 72h
        uint16 disputeBondBps; // FRIEND: bond = buyIn * bps / 10_000. FREEROLL: 0
        uint16[] payoutBps; // FRIEND podium split, length 1..3 and <= minSeats, sums to 10_000. FREEROLL: empty
        address inviteSigner; // FRIEND: invite key generated by the host's App. 0 = open
        bytes32 rulesHash; // keccak256 of the canonical rules JSON
        bool cryptoOnly; // FRIEND: must be true (factory check)
    }
}
